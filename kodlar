 Kubernetes ortamını hazırlama.
Metrics Server kurulumu.
Web uygulaması oluşturma.
HPA kurulumu.
Yük oluşturma ve Pod sayısını artırma.
Yükü durdurma ve Pod sayısını azaltma.

 1 - kubectl get nodes
 2 - kubectl version
 3 - kubectl get pods -n kube-system
 4 - kubectl get deployment metrics-server -n kube-system
 5- kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml
 6- kubectl patch deployment metrics-server -n kube-system --type=json -p='[{"op":"add","path":"/spec/template/spec/containers/0/args/-","value":"--kubelet-insecure-tls"}]'
 7- kubectl rollout status deployment/metrics-server -n kube-system --timeout=120s
 8- kubectl get pods -n kube-system
 9- kubectl top nodes
 10 - kubectl get deployment metrics-server -n kube-system
 11- kubectl top nodes
 12 - kubectl create deployment php-apache --image=registry.k8s.io/hpa-example --replicas=1
 13- kubectl set resources deployment php-apache --requests=cpu=200m
 14- kubectl expose deployment php-apache --port=80
 15- kubectl get deployments
 16- kubectl get pods
 17 - kubectl get services
 18 - kubectl autoscale deployment php-apache --cpu-percent=50 --min=1 --max=10
 19 - kubectl get hpa
 20 - kubectl run load-generator --image=busybox:1.36 --restart=Never -- /bin/sh -c 'while true; do wget -q -O- http://php-apache; done'
 21 - kubectl get hpa -w 
 22- kubectl get pods
 23- kubectl delete pod load-generator
 24 - kubectl get hpa
 25- kubectl get hpa -w
